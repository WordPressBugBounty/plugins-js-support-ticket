#: includes/classes/jsstadminsidemenu.php:518
#: modules/email/tpls/admin_emailhealth.php:28
msgid "Email Health"
msgstr ""

#: includes/classes/docs.php:92
msgid "Check whether an SMTP plugin is installed. A default WordPress install sends through the server's mail command, which most hosts either disable or send straight to spam. Email Health names the sender it is using."
msgstr ""

#: includes/classes/docs.php:97
msgid "Check the background queue. Notifications are queued rather than sent inside the request, so a queue nobody is working means every screen says the reply was posted and no mail ever leaves."
msgstr ""

#: includes/classes/docs.php:99
#: includes/classes/docs.php:120
#: includes/classes/docs.php:151
#: includes/classes/docs.php:162
#: includes/classes/docs.php:175
#: includes/classes/docs.php:180
